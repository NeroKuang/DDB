# Copy to .env.prod on the VPS (never commit .env.prod).
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- Compose interpolation (Postgres / MinIO container) ---
POSTGRES_PASSWORD=replace-with-strong-password
MINIO_ACCESS_KEY=ddb
MINIO_SECRET_KEY=replace-with-strong-password

# --- App ---
DATABASE_URL=postgresql://ddb:replace-with-strong-password@db:5432/ddb

AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_SECRET=replace-with-same-as-AUTH_SECRET
AUTH_URL=https://ddb.nerooodevvv-workshoppp.com
NEXTAUTH_URL=https://ddb.nerooodevvv-workshoppp.com
NEXT_PUBLIC_SITE_URL=https://ddb.nerooodevvv-workshoppp.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

CRON_SECRET=replace-with-openssl-rand-base64-32
# Used by the Compose `cron` sidecar (internal http://app:8080). Do not put this in host crontab.
# First boot only: 1 → confirm push → change to 0 → recreate app
RUN_DB_PUSH=1

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ddb
# Must match MINIO_ACCESS_KEY / MINIO_SECRET_KEY above
# (app reads these names)

STORE_ID=
LOGIN_ID=
LOGIN_PASSWORD=
