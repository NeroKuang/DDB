# 複製為 .env 或 .env.local。勿把真密鑰 commit。

# --- Postgres（庫名 ddb；可與 BeyRotate 共用 5432 實例）---
DATABASE_URL=postgresql://beyrotate:beyrotate_dev@localhost:5432/ddb

# --- DDB 登入（第一期種子 Admin 的帳號名＋密碼）---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:5003
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:5003
NEXT_PUBLIC_SITE_URL=http://localhost:5003
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 月結取數 cron（外部排程打 GET /api/cron/month-end-fetch）---
CRON_SECRET=

# --- MinIO（bucket ddb；可與 BeyRotate 共用 9000／9001）---
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ddb

# --- iCHEF 網頁取數（只讀營業報表；勿寫進 git／畫面／log）---
STORE_ID=
LOGIN_ID=
LOGIN_PASSWORD=
