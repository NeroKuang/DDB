# 複製為 .env 或 .env.local。勿把真密鑰 commit。

# --- Postgres（本機：docker compose 預設；庫名 ddb）---
# App 會自動補 connection_limit=10&pool_timeout=30（若 URL 尚未帶這些參數）
DATABASE_URL=postgresql://ddb:ddb_dev@localhost:5432/ddb

# --- DDB 登入（第一期種子 Admin 的帳號名＋密碼）---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:5003
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:5003
NEXT_PUBLIC_SITE_URL=http://localhost:5003
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- 月結取數 cron（外部排程打 GET /api/cron/month-end-fetch）---
# --- raw 保留 cron（外部排程打 GET /api/cron/storage-retention；Admin 亦可從 /storage-retention 手動觸發）---
CRON_SECRET=

# --- 本機除錯：設 1 才寫 storage/logs（Zeabur 預設看 Runtime Logs，勿依賴容器磁碟）---
# ERROR_LOG_TO_FILE=1

# --- MinIO（本機：docker compose 預設 bucket ddb；詳見 README／docs/DEPLOY-ZEABUR.md）---
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=ddb
MINIO_SECRET_KEY=ddb_dev_minio
MINIO_BUCKET=ddb

# --- iCHEF 網頁取數（只讀營業報表；勿寫進 git／畫面／log）---
STORE_ID=
LOGIN_ID=
LOGIN_PASSWORD=
