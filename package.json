{
  "name": "ddb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -e .env -- sh -c 'export NEXTAUTH_URL=${NEXTAUTH_URL:-$AUTH_URL}; export NEXTAUTH_SECRET=${NEXTAUTH_SECRET:-$AUTH_SECRET}; next dev -p 5003'",
    "build": "prisma generate && next build",
    "start": "sh -c 'next start -p ${PORT:-5003}'",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude src/fetch/ichef-web-fetch.test.ts --exclude src/fetch/ichef-reingest-august.test.ts",
    "test:ichef": "vitest run src/fetch/ichef-web-fetch.test.ts",
    "test:ichef-reingest-august": "dotenv -e .env.local -e .env -- vitest run src/fetch/ichef-reingest-august.test.ts",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -e .env -- prisma db push",
    "db:generate": "prisma generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
