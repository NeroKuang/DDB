generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  SUPERVISOR
  PERSONAL
}

enum StaffKind {
  REGULAR
  GUEST
}

enum PayKind {
  HOURLY
  MONTHLY
}

enum WebFetchStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         AccountRole
  staffId      String?     @map("staff_id")
  staff        Staff?      @relation(fields: [staffId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  staff         Staff[]
  templateTasks TemplateTask[]
  adHocTasks    AdHocTask[]
  payPeriods    PayPeriod[]
  staffTitles   StaffTitle[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("stores")
}

/** One 門市 × 一期薪資（periodKey 如 2026-07）。 */
model PayPeriod {
  id           String    @id @default(cuid())
  storeId      String    @map("store_id")
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  periodKey         String          @map("period_key")
  lockedAt          DateTime?       @map("locked_at")
  snapshotJson      String?         @map("snapshot_json") @db.Text
  fetchStatus       WebFetchStatus    @default(IDLE) @map("fetch_status")
  fetchStartedAt    DateTime?       @map("fetch_started_at")
  fetchFinishedAt   DateTime?       @map("fetch_finished_at")
  fetchErrorMessage String?         @map("fetch_error_message") @db.Text
  fetchRangeStart   String?         @map("fetch_range_start")
  fetchRangeEnd     String?         @map("fetch_range_end")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  staffSettings PayPeriodStaffSetting[]
  storedPayRows PayRowStored[]

  @@unique([storeId, periodKey])
  @@map("pay_periods")
}

model Staff {
  id                         String    @id @default(cuid())
  storeId                    String    @map("store_id")
  store                      Store     @relation(fields: [storeId], references: [id])
  legalName                  String    @map("legal_name")
  primaryNickname            String    @map("primary_nickname")
  contactPhone               String    @default("") @map("contact_phone")
  title                      String    @default("")
  kind                       StaffKind
  payKind                    PayKind   @map("pay_kind")
  hourlyRate                 Float     @default(0) @map("hourly_rate")
  monthlyPay                 Float     @default(0) @map("monthly_pay")
  commissionRate             Float     @default(0.2) @map("commission_rate")
  targetBonusAmount          Float     @default(0) @map("target_bonus_amount")
  laborHealthInsuranceAmount Float     @default(0) @map("labor_health_insurance_amount")
  payNote                    String    @default("") @map("pay_note")
  aliases                    StaffAlias[]
  users                      User[]
  adHocTasks                 AdHocTask[]
  payPeriodStaffSettings     PayPeriodStaffSetting[]
  storedPayRows              PayRowStored[]
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, primaryNickname])
  @@map("staff")
}

model StaffAlias {
  id        String   @id @default(cuid())
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  nickname  String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, nickname])
  @@map("staff_aliases")
}

model TemplateTask {
  id             String             @id @default(cuid())
  storeId        String             @map("store_id")
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemName       String             @map("item_name")
  amountPerClick Float              @map("amount_per_click")
  tiers          TemplateTaskTier[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([storeId, itemName])
  @@map("template_tasks")
}

model TemplateTaskTier {
  id             String       @id @default(cuid())
  templateTaskId String       @map("template_task_id")
  templateTask   TemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)
  minClicks      Int          @map("min_clicks")
  bonusAmount    Float        @map("bonus_amount")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([templateTaskId, minClicks])
  @@map("template_task_tiers")
}

/** One-off 追加任務 for a store period (periodKey e.g. 2026-07); not from POS. */
model AdHocTask {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId       String   @map("staff_id")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  periodKey     String   @map("period_key")
  name          String
  storedAmount  Float    @default(0) @map("stored_amount")
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([storeId, periodKey])
  @@map("ad_hoc_tasks")
}

/** Per 店員 per 薪資期間：場別／時數拆分、達標勾發、手填欄位歸屬。 */
model PayPeriodStaffSetting {
  id           String    @id @default(cuid())
  payPeriodId  String    @map("pay_period_id")
  payPeriod    PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staffId      String    @map("staff_id")
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  settingsJson Json      @map("settings_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([payPeriodId, staffId])
  @@map("pay_period_staff_settings")
}

/** Per 薪資列（店員×場別）的儲存值覆寫。 */
model PayRowStored {
  id          String    @id @default(cuid())
  payPeriodId String    @map("pay_period_id")
  payPeriod   PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staffId     String    @map("staff_id")
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue       String
  valuesJson  Json      @map("values_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([payPeriodId, staffId, venue])
  @@map("pay_row_stored")
}

/** Admin-maintained 職稱標籤清單（僅供篩選，不驅動公式）。 */
model StaffTitle {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([storeId, label])
  @@map("staff_titles")
}
