generator client {
  provider      = "prisma-client-js"
  // native = local Mac/Linux; debian-openssl-3.0.x = Playwright jammy / Ubuntu 22.04 runner
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  SUPERVISOR
  PERSONAL
}

enum StaffKind {
  REGULAR
  GUEST
}

enum PayKind {
  HOURLY
  MONTHLY
}

enum LaborHealthInsuranceMode {
  FIXED
  RATIO
}

enum UnmatchedNicknameResolutionKind {
  ATTRIBUTE_PERIOD
  CREATE_GUEST_PERIOD
}

enum WebFetchStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportSource {
  WEB_FETCH
  ADMIN_UPLOAD
}

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum RawFileKind {
  CHECKOUT
  PUNCHES
  NOTE_OUTER
  NOTE_DRILLDOWN
}

enum RawRetentionState {
  HOT
  ARCHIVED
  PURGED
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         AccountRole
  staffId      String?     @map("staff_id")
  staff        Staff?      @relation(fields: [staffId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  /** 新增店員時預填的業績成數（0～1）. */
  defaultCommissionRate   Float          @default(0.2) @map("default_commission_rate")
  staff                   Staff[]
  templateTasks TemplateTask[]
  adHocTasks    AdHocTask[]
  posItems      PosItem[]
  payPeriods    PayPeriod[]
  staffTitles   StaffTitle[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("stores")
}

/** One 門市 × 一期薪資（periodKey 如 2026-07）。 */
model PayPeriod {
  id           String    @id @default(cuid())
  storeId      String    @map("store_id")
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  periodKey         String          @map("period_key")
  lockedAt          DateTime?       @map("locked_at")
  snapshotJson      String?         @map("snapshot_json") @db.Text
  fetchStatus       WebFetchStatus    @default(IDLE) @map("fetch_status")
  fetchStartedAt    DateTime?       @map("fetch_started_at")
  fetchFinishedAt   DateTime?       @map("fetch_finished_at")
  fetchErrorMessage String?         @map("fetch_error_message") @db.Text
  fetchRangeStart   String?         @map("fetch_range_start")
  fetchRangeEnd     String?         @map("fetch_range_end")
  activeImportRunId String?         @map("active_import_run_id")
  skippedUnmatchedNicknames String[] @default([]) @map("skipped_unmatched_nicknames")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  unmatchedResolutions PayPeriodUnmatchedResolution[]
  staffSettings PayPeriodStaffSetting[]
  storedPayRows PayRowStored[]
  importRuns    ImportRun[]
  compileRuns   CompileRun[]

  @@unique([storeId, periodKey])
  @@map("pay_periods")
}

model Staff {
  id                         String    @id @default(cuid())
  storeId                    String    @map("store_id")
  store                      Store     @relation(fields: [storeId], references: [id])
  legalName                  String    @map("legal_name")
  primaryNickname            String    @map("primary_nickname")
  contactPhone               String    @default("") @map("contact_phone")
  title                      String    @default("")
  kind                       StaffKind
  payKind                    PayKind   @map("pay_kind")
  hourlyRate                 Float     @default(0) @map("hourly_rate")
  monthlyPay                 Float     @default(0) @map("monthly_pay")
  commissionRate             Float     @default(0.2) @map("commission_rate")
  targetBonusAmount          Float     @default(0) @map("target_bonus_amount")
  laborHealthInsuranceAmount Float     @default(0) @map("labor_health_insurance_amount")
  laborHealthInsuranceMode   LaborHealthInsuranceMode @default(FIXED) @map("labor_health_insurance_mode")
  laborHealthInsuranceRatio  Float     @default(0) @map("labor_health_insurance_ratio")
  laborHealthInsuranceCarryOverMonthly Boolean @default(true) @map("labor_health_insurance_carry_over_monthly")
  payNote                    String    @default("") @map("pay_note")
  /** 客座專用：僅在該薪資期間出現在薪資報表（如 2026-07）。 */
  guestPeriodKey             String?   @map("guest_period_key")
  aliases                    StaffAlias[]
  users                      User[]
  adHocTasks                 AdHocTask[]
  payPeriodStaffSettings     PayPeriodStaffSetting[]
  storedPayRows              PayRowStored[]
  unmatchedAttributions      PayPeriodUnmatchedResolution[] @relation("UnmatchedAttributionTarget")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, primaryNickname])
  @@map("staff")
}

/** 本期未對上暱稱的處理：認列給既有店員或本期客座建檔。 */
model PayPeriodUnmatchedResolution {
  id           String                          @id @default(cuid())
  payPeriodId  String                          @map("pay_period_id")
  payPeriod    PayPeriod                       @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  nickname     String
  kind         UnmatchedNicknameResolutionKind
  targetStaffId String?                        @map("target_staff_id")
  targetStaff  Staff?                          @relation("UnmatchedAttributionTarget", fields: [targetStaffId], references: [id], onDelete: SetNull)
  createdAt    DateTime                        @default(now()) @map("created_at")

  @@unique([payPeriodId, nickname])
  @@map("pay_period_unmatched_resolutions")
}

model StaffAlias {
  id        String   @id @default(cuid())
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  nickname  String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, nickname])
  @@map("staff_aliases")
}

model TemplateTask {
  id             String             @id @default(cuid())
  storeId        String             @map("store_id")
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemName       String             @map("item_name")
  amountPerClick Float              @map("amount_per_click")
  tiers          TemplateTaskTier[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([storeId, itemName])
  @@map("template_tasks")
}

model TemplateTaskTier {
  id             String       @id @default(cuid())
  templateTaskId String       @map("template_task_id")
  templateTask   TemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)
  minClicks      Int          @map("min_clicks")
  bonusAmount    Float        @map("bonus_amount")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([templateTaskId, minClicks])
  @@map("template_task_tiers")
}

/** iCHEF 注記品項主檔：售價由 Admin 維護，品項名稱自匯入自動偵測。 */
model PosItem {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  unitPrice  Float    @default(0) @map("unit_price")
  /** iCHEF 兌換／贈送品：售價固定 0，不列入缺價警告。 */
  isGift     Boolean  @default(false) @map("is_gift")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, name])
  @@map("pos_items")
}

/** One-off 追加任務 for a store period (periodKey e.g. 2026-07); not from POS. */
model AdHocTask {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId       String   @map("staff_id")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  periodKey     String   @map("period_key")
  name          String
  storedAmount  Float    @default(0) @map("stored_amount")
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([storeId, periodKey])
  @@map("ad_hoc_tasks")
}

/** Per 店員 per 薪資期間：場別／時數拆分、達標勾發、手填欄位歸屬。 */
model PayPeriodStaffSetting {
  id           String    @id @default(cuid())
  payPeriodId  String    @map("pay_period_id")
  payPeriod    PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staffId      String    @map("staff_id")
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  settingsJson Json      @map("settings_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([payPeriodId, staffId])
  @@map("pay_period_staff_settings")
}

/** Per 薪資列（店員×場別）的儲存值覆寫。 */
model PayRowStored {
  id          String    @id @default(cuid())
  payPeriodId String    @map("pay_period_id")
  payPeriod   PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staffId     String    @map("staff_id")
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue       String
  valuesJson  Json      @map("values_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([payPeriodId, staffId, venue])
  @@map("pay_row_stored")
}

/** Admin-maintained 職稱標籤清單（僅供篩選，不驅動公式）。 */
model StaffTitle {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([storeId, label])
  @@map("staff_titles")
}

model ImportRun {
  id             String              @id @default(cuid())
  payPeriodId    String              @map("pay_period_id")
  payPeriod      PayPeriod           @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  source         ImportSource
  status         ImportRunStatus     @default(RUNNING)
  startedAt      DateTime            @default(now()) @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  errorMessage   String?             @map("error_message") @db.Text
  fileRangeStart String?             @map("file_range_start")
  fileRangeEnd   String?             @map("file_range_end")
  noteOuterComplete Boolean          @default(false) @map("note_outer_complete")
  rawFiles       ImportRawFile[]
  checkoutLines  ImportCheckoutLine[]
  punchPairs     ImportPunchPair[]
  noteClicks     ImportNoteClick[]
  noteOuterItems ImportNoteOuterItem[]
  compileRuns    CompileRun[]

  @@index([payPeriodId, startedAt])
  @@map("import_runs")
}

model ImportRawFile {
  id             String            @id @default(cuid())
  importRunId    String            @map("import_run_id")
  importRun      ImportRun         @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  kind           RawFileKind
  originalName   String            @map("original_name")
  minioKey       String            @map("minio_key")
  sha256         String
  sizeBytes      Int               @map("size_bytes")
  retentionState RawRetentionState @default(HOT) @map("retention_state")
  archivedKey    String?           @map("archived_key")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([importRunId])
  @@index([retentionState])
  @@map("import_raw_files")
}

model ImportCheckoutLine {
  id          String    @id @default(cuid())
  importRunId String    @map("import_run_id")
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  nickname    String
  amount      Float
  orderer     String    @default("")
  voided      Boolean   @default(false)
  occurredAt  DateTime  @map("occurred_at")

  @@index([importRunId, nickname])
  @@map("import_checkout_lines")
}

model ImportPunchPair {
  id          String    @id @default(cuid())
  importRunId String    @map("import_run_id")
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  nickname    String
  hours       Float
  paired      Boolean   @default(true)

  @@index([importRunId, nickname])
  @@map("import_punch_pairs")
}

model ImportNoteClick {
  id          String    @id @default(cuid())
  importRunId String    @map("import_run_id")
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  itemName    String    @map("item_name")
  nickname    String
  clicks      Int

  @@index([importRunId, nickname, itemName])
  @@map("import_note_clicks")
}

/** POS 注記分析外層（品項 × 累計加減價額），供售價 ÷ 點選數。 */
model ImportNoteOuterItem {
  id          String    @id @default(cuid())
  importRunId String    @map("import_run_id")
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  name        String
  clicks      Int
  priceTotal  Float     @map("price_total")

  @@unique([importRunId, name])
  @@index([importRunId])
  @@map("import_note_outer_items")
}

model CompileRun {
  id                      String    @id @default(cuid())
  importRunId             String    @map("import_run_id")
  importRun               ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  payPeriodId             String    @map("pay_period_id")
  payPeriod               PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  compiledAt              DateTime  @default(now()) @map("compiled_at")
  auditMinioKey           String    @map("audit_minio_key")
  auditSha256             String    @map("audit_sha256")
  payRowCount             Int       @map("pay_row_count")
  unmatchedNicknamesCount Int       @map("unmatched_nicknames_count")
  unmatchedClicksCount    Int       @map("unmatched_clicks_count")
  resultJson              String?   @map("result_json") @db.Text

  @@index([payPeriodId, compiledAt])
  @@map("compile_runs")
}
